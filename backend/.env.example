# Supabase project settings (Project Settings -> API Keys -> Publishable and
# secret API keys tab)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# No JWT secret needed: this project issues tokens signed with modern
# asymmetric JWT signing keys (ES256), verified against Supabase's public
# JWKS at {SUPABASE_URL}/auth/v1/.well-known/jwks.json (see app/security.py).

# Domain used for synthetic, never-shown login emails: {username}@SYNTHETIC_EMAIL_DOMAIN
SYNTHETIC_EMAIL_DOMAIN=ksp.internal

# Origin the frontend dev server runs on, for CORS.
FRONTEND_ORIGIN=http://localhost:3000

# Sarvam AI Saaras v3 STT (voice intake, VOICE_INTAKE_STEERING.md). Backend-only
# — never exposed to the client. Distinct from any orchestrator LLM credentials.
SARVAM_API_KEY=your-sarvam-api-key

# Runtime flag: disables voice capture without a deploy. When false, the
# transcribe endpoint 404s and the frontend hides the mic button.
VOICE_INTAKE_ENABLED=true

# --- Data seeding (SEED_RUNBOOK.md) — used only by scripts/seed/*, not the app ---

# Direct Postgres connection string for DDL, PostGIS, and bulk COPY. This is the
# "Connection string" from Supabase → Project Settings → Database (NOT the REST
# URL above). Service role; RLS is bypassed by design during seeding. Percent-encode
# any special characters (#, @, :, /, %) in the password.
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Anchors all relative seeds (chargesheet deadlines, upcoming Dasara, etc.).
# Format: YYYY-MM-DD. Re-running the seeder with a new date refreshes the demo.
SEED_DEMO_DATE=2026-07-14

# HuggingFace read-scoped access token, required for IndicTrans2 (a gated
# repo) — request access at https://huggingface.co/ai4bharat/indictrans2-en-indic-1B,
# then generate a token at https://huggingface.co/settings/tokens.
HF_TOKEN=hf_your-token-here
